<odoo>
    <!-- -->
    <record id="view_matiere_list" model="ir.ui.view">
        <field name="name">school.matiere.list</field>
        <field name="model">school.matiere</field>
        <field name="arch" type = "xml" >
            <list>
                <field name="name"/>
                <field name="professeur_id"/>
            </list>
        </field>
    </record>
    <!-- -->
    <record id="view_matiere_form" model="ir.ui.view">
        <field name="name">school.matiere.form</field>
        <field name="model">school.matiere</field>
        <field name="arch" type = "xml" >
               <form>
               <sheet>
                   <group>
                       <field name="name"/>
                       <field name="professeur_id"/>
                       <field name="specialite_id"/>
                       <field name="code"/>
                       <field name="coef"/>
                       <field name="vol_course"/>
                       <field name="vol_td"/>
                       <field name="vol_tp"/>
                   </group>>
               </sheet>
               </form>

        </field>

    </record>
    <!-- -->
    <record id="action_matiere" model="ir.actions.act_window">
        <field name="name">Matiere</field>
        <field name="res_model">school.matiere</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>