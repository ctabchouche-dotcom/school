<odoo>

  <record id="view_school_programvolume_list" model="ir.ui.view">
    <field name="name">school.program_volume.list</field>
    <field name="model">school.program_volume</field>
    <field name="arch" type="xml">
      <list>
        <field name="program_id"/>
        <field name="matiere_id"/>
        <field name="cours"/>
        <field name="td"/>
        <field name="tp"/>
      </list>
    </field>
  </record>

  <record id="view_school_programvolume_form" model="ir.ui.view">
    <field name="name">school.program_volume.form</field>
    <field name="model">school.program_volume</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
            <group>
                 <field name="program_id"/>
                 <field name="matiere_id"/>
                 <field name="cours"/>
                 <field name="td"/>
                 <field name="tp"/>
            </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_program_volume" model="ir.actions.act_window">
        <field name="name">Volume horaire programme</field>
        <field name="res_model">school.program_volume</field>
        <field name="view_mode">list,form</field>
  </record>

</odoo>
