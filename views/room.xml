<odoo>
    <!-- -->
    <record id="view_room_list" model="ir.ui.view">
        <field name="name">school.room.list</field>
        <field name="model">school.room</field>
        <field name="arch" type = "xml" >
            <list>
                <field name="name"/>
                <field name="room_type"/>
            </list>
        </field>
    </record>
    <!-- -->
    <record id="view_room_form" model="ir.ui.view">
        <field name="name">school.room.form</field>
        <field name="model">school.room</field>
        <field name="arch" type = "xml" >
               <form>
               <sheet>
                   <group>
                       <field name="name"/>
                       <field name="room_type"/>
                   </group>>
               </sheet>
               </form>

        </field>

    </record>
    <!-- -->
    <record id="action_room" model="ir.actions.act_window">
        <field name="name">Salles</field>
        <field name="res_model">school.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>