<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_school" inherit_id="portal.portal_my_home" priority="10">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <a href="/my/grade" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                <span>Mon Bulletin Scolaire</span>
                <span class="badge rounded-pill bg-primary">Consulter</span>
            </a>
            <a href="/my/absences" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                <span>Mes Absences</span>
                <span class="badge rounded-pill bg-danger">Consulter</span>
            </a>
            <a href="/my/reclamation" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                <span>Mes Reclamations</span>
                <span class="badge rounded-pill bg-danger">Consulter</span>
            </a>
            <a href="/my/badge" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                <span>Mon badge</span>
                <span class="badge rounded-pill bg-danger">Consulter</span>
            </a>
        </xpath>
    </template>
</odoo>

