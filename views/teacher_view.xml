<odoo>

    <!-- vuz liste -->
    <record id="view_teacher_list" model="ir.ui.view">
        <field name="name">school.teacher.list</field>
        <field name="model">school.teacher</field>
        <field name="arch" type = "xml" >
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="matiere_id"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="view_teacher_form" model="ir.ui.view">
           <field name="name">school.teacher.form</field>
           <field name="model">school.teacher</field>
           <field name="arch" type="xml">
               <form>
               <sheet>
                   <group>
                       <field name="name"/>
                       <field name="user_id"/>
                       <field name="email"/>
                       <field name="phone"/>
                       <field name="state_prof"/>
                       <notebook>
                           <page string="Matieres">
                               <field name="matiere_id">
                               <list editable="bottom">
                               <field name="name"/>
                               </list>
                               </field>
                           </page>
                       </notebook>
                       <field name="affectation_id" >
                       <list editable="bottom">
                           <field name="teacher_id"/>
                           <field name="matiere_id"/>
                           <field name="classe_id"/>
                           <field name="semester"/>
                       </list>
                       </field>

                   </group>
               </sheet>
               </form>
           </field>
    </record>
    <!-- action -->
    <record id="action_teacher" model="ir.actions.act_window">
        <field name="name">Professeur</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>