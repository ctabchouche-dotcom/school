<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_school_user" model="res.groups">
        <field name="name">École : Étudiant</field>
    </record>

    <record id="group_school_teacher" model="res.groups">
        <field name="name">École : Enseignant</field>
        <field name="implied_ids" eval="[(4, ref('group_school_user'))]"/>
    </record>

    <record id="group_school_manager" model="res.groups">
        <field name="name">École : Administrateur</field>
        <field name="implied_ids" eval="[(4, ref('group_school_teacher'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Tout compte Settings (admin) hérite de l'administration école. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_school_manager'))]"/>
    </record>
</odoo>
